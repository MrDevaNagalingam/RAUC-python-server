APP_NAME=Python OTA Server
APP_ENV=development
DATABASE_URL=sqlite:///./ota.db
ARTIFACT_STORAGE_PATH=./storage/artifacts
# Set to an address reachable from the lab gateway. No trailing slash.
PUBLIC_BASE_URL=http://127.0.0.1:8081
POLLING_INTERVAL_SECONDS=60
OFFLINE_THRESHOLD_SECONDS=180
MAX_DDI_BODY_BYTES=65536
MAX_UPLOAD_SIZE_MB=2048
SESSION_HOURS=12
FRONTEND_PATH=../frontend/dist
LOG_LEVEL=INFO
DEFAULT_TENANT=DEFAULT
# JSON list. Add the reachable hostname/IP used by the target.
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# Used by docker compose; for direct uvicorn use --port explicitly.
HTTP_PORT=8081
